;;;
;;;; Unsafe Calls
;;;


(declare
  (block)
  (standard-bindings)
  (extended-bindings)
  (not safe))


(define zen:debug-core?
  (eq? zen:kernel-safety 'core))

(define zen:debug-user?
  (not (eq? zen:kernel-safety 'sealed)))

(define zen:debug-check?
  (or (eq? zen:kernel-safety 'core)
      (eq? zen:kernel-safety 'debug)))

(define zen:debug-flonum?
  (if (memq 'finite zen:kernel-features)
      #f
    zen:debug-core?))


(zen:define-synto (%%danger name expr)
  #;
  `(begin
     (pp '(***DANGER ,name))
     ,expr)
  expr)


(zen:define-synto (zen:unsafe expr)
  (let ((form (##source-code expr)))
    (let ((oper (##car form))
          (args (##cdr form)))
      `(let ()
         (declare (not safe))
         (,oper ,@(map (lambda (arg)
                         (if zen:debug-user?
                             `(let ()
                                (declare (safe))
                                ,arg)
                           arg))
                       args))))))


(zen:define-macro (zen:define-unsafe name)
  (let ((str (symbol->string name)))
    (let ((suffix (substring str 2 (string-length str))))
      (let ((lowlevel (string->symbol (string-append "##" suffix))))
        `(zen:define-synto (,name . rest)
           `(zen:unsafe (,',lowlevel ,@rest)))))))



(data jazz.ide.data.project


(import (jazz.project))


(form
  (<Project> name: zen depot-directory: {Directory :context}
    (<*>               tag-reference: {File :context "kernel" ".project"})
    (<*>               tag-reference: {File :context "lib" ".project"}))))

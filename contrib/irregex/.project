;;;; Project
;;;


(data jazz.ide.data.project


(import (jazz.project)
        (jazz.editor.jazz))


(form
  (<Project>                 name: irregex description-file: {File :context ".package"}
    (<Project-Directory>                   directory: {Directory :context "implementation"}
      (<Project-File>                      source: {File :context "implementation" "irregex.scm"}))
    (<Project-File>                        source: {File :context "_.zen"}))))
